# Copy to .env.local (chmod 600). Never commit real values.
APP_URL=http://localhost:3005
SESSION_SECRET=            # 64 hex chars: openssl rand -hex 32
CREDENTIALS_MASTER_KEY=    # openssl rand -base64 32
DATABASE_URL=postgres://kitpier@127.0.0.1:5433/kitpier
TEST_DATABASE_URL=postgres://kitpier@127.0.0.1:5433/kitpier_test
# DATABASE_SSL=require     # hosted Postgres (e.g. Neon)

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=   # same as PAYPAL_CLIENT_ID
PAYPAL_MERCHANT_ID=             # your sandbox business account's merchant id
PAYPAL_WEBHOOK_ID=              # from registering <APP_URL>/api/paypal/webhook

ANTHROPIC_API_KEY=
PLATFORM_DAILY_AI_CAP_MICROS=20000000

# Connected listings
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# Kitpier's own email (password reset): a Resend sending-only key limited to the verified domain
RESEND_API_KEY=
MAIL_FROM="Kitpier <noreply@kitpier.com>"

# Judge demo connection (optional): a Supabase project in a separate org; table SQL = DEMO_BOOKINGS_SQL in src/lib/demo.ts
DEMO_SUPABASE_REF=
DEMO_SUPABASE_SECRET_KEY=
